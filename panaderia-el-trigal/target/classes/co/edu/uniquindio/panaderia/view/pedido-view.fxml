<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.panaderia.viewcontrollers.PedidoViewController"
      spacing="14">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Zona Superior: Formulario de Registro de Pedido -->
    <VBox spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6;">
        <Label text="Registro de Pedido de Panadería" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="130" prefWidth="150"/>
                <ColumnConstraints minWidth="220" prefWidth="280" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="130" prefWidth="150"/>
                <ColumnConstraints minWidth="220" prefWidth="280" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Código del pedido:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCodigoPedido" promptText="Ej: P01" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="txtCliente" promptText="Ej: Café Central" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Tipo de pan:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbTipoPan" promptText="Seleccione tipo de pan..." maxWidth="Infinity"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Cantidad de panes:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtCantidad" promptText="Ej: 25" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
        </GridPane>

        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="btnRegistrarPedido" text="Registrar Pedido (PENDIENTE)" onAction="#onRegistrarPedido"
                    style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <!-- Zona Central: Tabla Historial de Pedidos y Botones de Acción -->
    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Historial de Pedidos (Incluye Activos y Cancelados)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAsignarPedido" text="Asignar a Producción" onAction="#onAsignarPedido"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button fx:id="btnCancelarPedido" text="Cancelar Pedido" onAction="#onCancelarPedido"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>

        <TableView fx:id="tblPedidos" prefHeight="180" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPedCodigo" text="Código" prefWidth="80"/>
                <TableColumn fx:id="colPedCliente" text="Cliente" prefWidth="180"/>
                <TableColumn fx:id="colPedTipoPan" text="Tipo de Pan" prefWidth="120"/>
                <TableColumn fx:id="colPedCantidad" text="Cantidad" prefWidth="90"/>
                <TableColumn fx:id="colPedEstado" text="Estado" prefWidth="110"/>
                <TableColumn fx:id="colPedEmpleado" text="Empleado Asignado" prefWidth="140"/>
                <TableColumn fx:id="colPedMinutos" text="Min. Reservados" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Zona Inferior: Tabla de Disponibilidad de Empleados -->
    <VBox spacing="8" prefHeight="160">
        <Label text="Disponibilidad Actual de Empleados (Seguimiento de Minutos)" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #475569;"/>
        <TableView fx:id="tblDisponibilidad" prefHeight="130" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colEmpCodigo" text="Código" prefWidth="90"/>
                <TableColumn fx:id="colEmpNombre" text="Nombre" prefWidth="260"/>
                <TableColumn fx:id="colEmpTipo" text="Tipo de Empleado" prefWidth="220"/>
                <TableColumn fx:id="colEmpMinutos" text="Minutos Disponibles" prefWidth="160"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>