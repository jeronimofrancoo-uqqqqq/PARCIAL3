<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.panaderia.viewcontrollers.MainViewController"
            prefWidth="1024" prefHeight="700">
  <center>
    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
      <tabs>
        <Tab text="Empleados">
          <content>
            <fx:include fx:id="empleadoView" source="empleado-view.fxml"/>
          </content>
        </Tab>
        <Tab text="Pedidos">
          <content>
            <fx:include fx:id="pedidoView" source="pedido-view.fxml"/>
          </content>
        </Tab>
      </tabs>
    </TabPane>
  </center>
</BorderPane>