<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.panaderia.viewcontrollers.EmpleadoViewController"
      spacing="15">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Zona Superior: Formulario de Registro -->
    <VBox spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6;">
        <Label text="Registro de Nuevo Empleado" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="150" prefWidth="170"/>
                <ColumnConstraints minWidth="250" prefWidth="300" hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="150" prefWidth="170"/>
                <ColumnConstraints minWidth="250" prefWidth="300" hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Fila 0 -->
            <Label text="Tipo de empleado:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbTipoEmpleado" promptText="Seleccione tipo..." maxWidth="Infinity"
                      onAction="#onTipoEmpleadoSeleccionado" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Nombre completo:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="txtNombre" promptText="Ej: Ana María Gómez" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <!-- Fila 1 -->
            <Label text="Documento (C.C.):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtDocumento" promptText="Ej: 1094888999" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Código único:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtCodigo" promptText="Ej: E01" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <!-- Fila 2 -->
            <Label text="Minutos disponibles:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMinutos" promptText="Ej: 120" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Caja asignada (solo cajero):" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <TextField fx:id="txtCaja" promptText="Ej: Caja 1" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="btnLimpiar" text="Limpiar Formulario" onAction="#onLimpiar"/>
            <Button fx:id="btnRegistrar" text="Registrar Empleado" onAction="#onRegistrarEmpleado"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <!-- Zona Central: Tabla de Empleados Registrados -->
    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="Listado de Empleados (Orden de Registro)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
                <TableColumn fx:id="colNombre" text="Nombre Completo" prefWidth="220"/>
                <TableColumn fx:id="colDocumento" text="Documento (C.C.)" prefWidth="130"/>
                <TableColumn fx:id="colTipo" text="Tipo de Empleado" prefWidth="180"/>
                <TableColumn fx:id="colMinutos" text="Minutos Disp." prefWidth="110"/>
                <TableColumn fx:id="colCaja" text="Caja Asignada" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>